{
  "name": "behind-the-answer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "eslint": "10.8.1",
    "playwright": "1.62.1"
  },
  "scripts": {
    "check:syntax": "find js tests -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "check:lint": "eslint js tests --no-config-lookup --rule 'no-unused-vars: [\"error\", {\"args\":\"after-used\",\"caughtErrors\":\"none\"}]'",
    "check:static": "node tests/static-integrity.mjs && node tests/legacy-cleanup.mjs",
    "check:storage": "node tests/storage-schema.mjs",
    "check:css": "node tests/css-integrity.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "test:browser": "node tests/smoke.mjs",
    "test:journey": "node tests/full-journey.mjs",
    "test:regression:data-governance": "node tests/regression-data-governance.mjs",
    "test:regression:revisions-failover": "node tests/regression-revisions-failover.mjs",
    "test:regression:guidance-history": "node tests/regression-guidance-history.mjs",
    "test:regression:causality-results": "node tests/regression-causality-results.mjs",
    "test:regression:state-roles": "node tests/regression-state-roles.mjs",
    "test:regression:clarity-remediation": "node tests/regression-clarity-remediation.mjs"
  }
}
